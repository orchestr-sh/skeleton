{
  "name": "@orchestr-sh/skeleton",
  "version": "1.3.0",
  "type": "module",
  "description": "Official starter skeleton for Orchestr - Laravel for TypeScript",
  "main": "dist/bootstrap/app.js",
  "types": "dist/bootstrap/app.d.ts",
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc && cp -r resources dist/resources && mkdir -p dist/bootstrap/cache dist/storage/framework/cache/data dist/database",
    "dev": "tsx watch public/index.ts",
    "start": "node dist/public/index.js",
    "orchestr": "tsx bootstrap/cli.ts",
    "migrate": "tsx bootstrap/cli.ts migrate",
    "seed": "tsx bootstrap/cli.ts db:seed",
    "fresh": "tsx bootstrap/cli.ts migrate:fresh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:lint": "oxlint . --type-aware && oxfmt --check .",
    "test:types": "oxlint . --type-aware --type-check",
    "lint": "oxlint . --type-aware --fix && oxfmt --write ."
  },
  "keywords": [
    "orchestr",
    "laravel",
    "typescript",
    "framework",
    "skeleton"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@orchestr-sh/orchestr": "^1.12.10",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
